# Build-time settings. Put local overrides in .env.local (not committed).
# Backend URL; can also be set at deploy time in public/config.js.
VITE_BACKEND_HOST=
# Default theme color (hex). Default: #4188f1. Can be overridden in config.js.
VITE_PRIMARY_COLOR=
# App name for the PWA manifest. Default: MediaBBS
VITE_SITE_NAME=
# Default skin. Default: liberty. Can be overridden in config.js.
VITE_DEFAULT_SKIN=
